# Конфигурация endpoint-агента этого ПК. Скопируйте в endpoint_agent.env
# рядом с исполняемым файлом/скриптом и заполните значения, выданные при
# регистрации в /admin/endpoint-agents на сервере ВАШЕЙ площадки (не
# центрального сервера — endpoint-агент никогда не обращается к центру
# напрямую, см. docs/PRINTER_MONITORING_FORECASTING.md).

# Базовый URL веб-сервера площадки (тот же процесс, что показывает /reports).
# ОБЯЗАТЕЛЬНО https в production.
SERVER_BASE_URL=https://printserver.example.local:8443

# Выдаются один раз при регистрации/ротации в /admin/endpoint-agents.
ENDPOINT_UUID=
ENDPOINT_TOKEN=

# Необязательно: переопределить имя компьютера (по умолчанию берётся из ОС).
# HOSTNAME_OVERRIDE=

# Интервалы (секунды).
POLL_INTERVAL_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=300
HTTP_TIMEOUT_SECONDS=30

# Журнал событий (по умолчанию соответствуют стандартной службе печати
# Windows — как правило, менять не нужно).
EVENT_LOG_NAME=Microsoft-Windows-PrintService/Operational
EVENT_ID=307
MAX_EVENTS_PER_RUN=2000
BATCH_SIZE=200

# Разрешить/запретить учёт по имени принтера (через запятую, поддерживаются
# шаблоны с *). Пусто — разрешены все локальные/прямые принтеры (см.
# endpoint_agent/ports.py про исключение сетевых очередей Print Server).
# PRINTER_ALLOWLIST=HP-LaserJet-*,Canon-*
# PRINTER_DENYLIST=Microsoft Print to PDF,Fax

# Калибровка индексов Properties события 307 — см.
# collector/calibrate_event_fields.ps1 (тот же журнал/событие, что и на
# Print Server). Значения по умолчанию заданы в endpoint_agent/config.py
# и подходят для типичной раскладки клиентских Windows 10/11, но ДОЛЖНЫ
# быть перепроверены на конкретном образе/версии.
# FIELD_MAP_JOB_ID=0
# FIELD_MAP_DOCUMENT_NAME=1
# FIELD_MAP_USER_NAME=2
# FIELD_MAP_PRINTER_NAME=4
# FIELD_MAP_SOURCE_COMPUTER=3
# FIELD_MAP_TOTAL_PAGES=8

LOG_LEVEL=INFO
# LOG_DIR=logs
# DB_PATH=endpoint_agent_outbox.sqlite3
