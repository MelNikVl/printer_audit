# Скопируйте этот файл в .env и заполните реальными значениями для вашего домена.
# .env НИКОГДА не коммитится (см. .gitignore) — пароль сервисного bind-аккаунта
# и параметры AD не должны попадать в Git, в БД или в логи.
#
# .env читается через python-dotenv при старте веб-приложения/сборщика/CLI,
# если файл присутствует в корне репозитория; на проде можно вместо файла
# задать те же переменные как переменные окружения процесса/службы.

# --- Провайдеры входа ---
# Оба независимы друг от друга. Если переменная вообще ОТСУТСТВУЕТ в .env,
# код трактует и LOCAL_AUTH_ENABLED, и AD_AUTH_ENABLED как true — так апгрейд
# уже развёрнутого сервера, где AD уже настроен и используется, не отключает
# его молча только потому, что в старом .env не было этой строки. Реально AD
# доступен только при AD_AUTH_ENABLED=true И заполненных AD_SERVER/AD_BASE_DN
# ниже — одного флага недостаточно. При AD_AUTH_ENABLED=false (или AD не
# настроен) код не делает ни одного обращения к LDAP и не показывает
# форму/ошибки AD в интерфейсе — см. docs/ADMIN_GUIDE.md.
#
# Ниже — пример для СВЕЖЕЙ установки без AD (пилот на локальных учётках):
# явно выставленный AD_AUTH_ENABLED=false отключает AD, даже если ниже
# случайно окажутся заполненные AD_SERVER/AD_BASE_DN. Уберите эту строку
# (или поставьте true) и заполните секцию AD ниже, если AD нужен.
LOCAL_AUTH_ENABLED=true
AD_AUTH_ENABLED=false

# --- Active Directory (LDAP/LDAPS) — только если AD_AUTH_ENABLED=true ---
AD_SERVER=dc01.example.local
AD_PORT=636
# true = LDAPS (обязательно для продакшена — пароль пользователя иначе идёт в открытом виде)
AD_USE_SSL=true

# ВАЖНО — единственная модель, без вариантов: AD_DOMAIN — это DNS-имя домена
# (он же UPN suffix), а НЕ короткое NetBIOS-имя. Используется для построения
# UPN при входе пользователя: login становится "sam@AD_DOMAIN" (например,
# "ivanov@corp.example.local"), независимо от того, в каком из трёх форматов
# (DOMAIN\login / login@domain / login) пользователь ввёл логин в форме —
# то, что он ввёл в качестве домена/NetBIOS-префикса, ИГНОРИРУЕТСЯ и не
# участвует в bind. Тот же AD_DOMAIN используется для отображаемого
# "нормализованного" логина в БД/аудите/UI (значит, там вы увидите
# "corp.example.local\ivanov", а не "CORP\ivanov" — это ожидаемо).
#
#   ПРАВИЛЬНО:   AD_DOMAIN=corp.example.local
#   НЕПРАВИЛЬНО: AD_DOMAIN=CORP        <- это NetBIOS-имя, а не DNS/UPN suffix;
#                                         с ним bind как "ivanov@CORP" почти
#                                         наверняка НЕ пройдёт на реальном AD.
#
# Отдельная переменная для NetBIOS-имени домена (например AD_NETBIOS_DOMAIN)
# сейчас НЕ нужна и не читается кодом — если у вас несколько NetBIOS-имён на
# один DNS-домен или наоборот, это отдельный случай вне этого пилота.
AD_DOMAIN=corp.example.local

AD_BASE_DN=DC=corp,DC=example,DC=local
AD_USER_SEARCH_BASE=OU=Users,DC=corp,DC=example,DC=local
AD_GROUP_SEARCH_BASE=OU=Groups,DC=corp,DC=example,DC=local

# Сервисный bind-аккаунт для поиска пользователей/групп (не обязателен для
# самого логина — вход проверяется bind'ом от имени самого пользователя).
# Минимальные права: обычный пользователь домена с правом читать атрибуты
# sAMAccountName, userPrincipalName, displayName, mail, objectSid, objectGUID,
# memberOf, distinguishedName в AD_USER_SEARCH_BASE/AD_GROUP_SEARCH_BASE.
# Права администратора домена НЕ нужны и не должны выдаваться.
#
# Формат значения — то, что реально передаётся ldap3/AD для bind, а не то,
# что парсит наш код: подходит UPN (как ниже) или полный DN
# ("CN=svc-printaudit,OU=ServiceAccounts,..."). Down-level формат
# "NETBIOS\login" тоже технически работает с Active Directory, но здесь
# специально показан UPN — тот же формат, что и AD_DOMAIN выше, чтобы не
# городить в одном файле два разных способа записи домена.
AD_BIND_USER=svc-printaudit@corp.example.local
AD_BIND_PASSWORD=CHANGE_ME

# --- Веб-сессии ---
# Случайный секрет для подписи/хеширования токенов сессии. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
# Срок жизни сессии в минутах
SESSION_LIFETIME_MINUTES=480
# true в продакшене за HTTPS (ставит флаг Secure на cookie сессии/CSRF)
SESSION_COOKIE_SECURE=false

# --- Bootstrap первого superadmin (см. scripts/bootstrap_superadmin.py) ---
# Логин в любом из форматов DOMAIN\login / login@domain / login — используется
# ТОЛЬКО при явном запуске CLI-команды bootstrap, не при обычной работе сервиса.
# Формат DOMAIN\login здесь допустим (это просто ОДИН ИЗ трёх способов ввода
# логина, который normalize_login() приведёт к единому виду), в отличие от
# AD_DOMAIN выше, который обязан быть DNS-именем для построения UPN при bind.
# BOOTSTRAP_SUPERADMIN_LOGIN=CORP\ivanov
#
# Для локальной (не-AD) установки первый superadmin создаётся не через .env,
# а интерактивной CLI-командой, которая сама спросит пароль (getpass, дважды,
# не отображается на экране, аргументом командной строки не принимается):
#   python scripts\bootstrap_local_superadmin.py --login localadmin

# --- Режим приложения (мультиплощадочная архитектура) ---
# См. docs/MULTISITE_ARCHITECTURE.md. Три режима:
#   standalone (по умолчанию) — обычная локальная работа без центра, как раньше.
#   agent      — этот процесс — Print Server на площадке: собирает события
#                локально (как обычно) И дополнительно отправляет их в центр
#                через durable outbox (collector/agent_sync.py).
#   central    — этот процесс принимает события от агентов и отдаёт общий
#                веб-интерфейс/API по всем площадкам; сам события локально не собирает.
#
# Если строка есть, но значение не входит в эти три — приложение/CLI-скрипты
# ОТКАЖУТСЯ работать (InvalidAppModeError) вместо того, чтобы молча
# откатиться на standalone: опечатка здесь не должна незаметно менять
# режим production-сервера.
APP_MODE=standalone

# --- Только для APP_MODE=agent ---
# Все 4 переменные ниже обязательны вместе. Секрет агента — ТОЛЬКО здесь,
# в .env, никогда в config.yaml (который не считается секретным и может
# синхронизироваться между площадками) и никогда аргументом командной строки.
#
# CENTRAL_BASE_URL — адрес центрального Print Audit, ОБЯЗАТЕЛЬНО https:// в
# продакшене (см. AGENT_REQUIRE_HTTPS ниже) — агент сам инициирует исходящее
# соединение к центру, входящих портов на Print Server открывать не нужно.
# CENTRAL_BASE_URL=https://print-audit.corp.example.local
#
# AGENT_SITE_UUID / AGENT_PRINT_SERVER_UUID — берутся из /admin/print-servers
# центрального сервера в момент регистрации ЭТОГО Print Server (не путать с
# site_code в config.yaml — это разные идентификаторы: site_code/server_name
# используются только для локальной авто-регистрации в СВОЕЙ базе, а
# AGENT_SITE_UUID/AGENT_PRINT_SERVER_UUID — это то, кем агент представляется
# центру).
# AGENT_SITE_UUID=
# AGENT_PRINT_SERVER_UUID=
#
# AGENT_TOKEN — токен агента, показанный ОДИН РАЗ на странице
# /admin/print-servers центрального сервера при регистрации/ротации.
# AGENT_TOKEN=
#
# true в продакшене (агентский API центра принимает только HTTPS); ставить
# false можно только для локальной проверки без TLS.
AGENT_REQUIRE_HTTPS=true

# --- Реверс-прокси перед центральным сервером (nginx/IIS/...) ---
# Если TLS завершается на реверс-прокси, а до uvicorn запрос доходит уже
# как обычный HTTP — AGENT_REQUIRE_HTTPS=true увидит "http" и ошибочно
# отклонит ЛЕГИТИМНЫЙ трафик агентов, если не сказать приложению, каким
# прокси доверять заголовок X-Forwarded-Proto.
#
# TRUSTED_PROXY_IPS — список через запятую IP-адресов, ОТКУДА разрешено
# принимать X-Forwarded-Proto как источник истины про исходную схему
# (см. webapp/middleware.py::TrustedProxyHeadersMiddleware). Это должен
# быть IP САМОГО реверс-прокси (то, что видит uvicorn как peer), а НЕ
# IP конечного клиента/агента. Пусто по умолчанию — значит заголовку не
# доверяет НИКТО и запрос напрямую (без прокси) должен реально быть HTTPS.
#
#   ПРАВИЛЬНО:   TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.5   (IP самого nginx/IIS)
#   НЕПРАВИЛЬНО: TRUSTED_PROXY_IPS=<IP печатного сервера/агента> — тогда
#                любой, кто может подключиться напрямую к uvicorn под видом
#                этого IP, сможет подделать X-Forwarded-Proto: https и
#                обойти AGENT_REQUIRE_HTTPS.
#
# Не задавайте эту переменную вообще, если сервер стоит без реверс-прокси
# (uvicorn слушает HTTPS напрямую, либо AGENT_REQUIRE_HTTPS=false для теста).
# TRUSTED_PROXY_IPS=
